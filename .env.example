# 복사해서 .env로 저장하고 값을 채운다. .env는 커밋하지 않는다.
POSTGRES_DB=songhak
POSTGRES_USER=songhak
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://songhak:비밀번호@127.0.0.1:5432/songhak
# 자연어 질의용 읽기 전용 계정. 값을 채운 뒤 backend에서 python -m app.qa.create_user
QA_DATABASE_URL=postgresql+psycopg://qa_agent:비밀번호@127.0.0.1:5432/songhak
# 로그인 토큰 서명 키 (32자 이상, 예: python -c "import secrets;print(secrets.token_urlsafe(48))")
AUTH_SECRET=
# 로컬 개발(http)에서만 0. 배포 환경에서는 지우거나 1
COOKIE_SECURE=0
# 자연어 질의 (Claude API). console.anthropic.com에서 발급
ANTHROPIC_API_KEY=

# --- 운영 서버(docker-compose.prod.yml)에서만. 순서는 docs/deploy.md ---
# 운영에서는 DATABASE_URL·QA_DATABASE_URL·COOKIE_SECURE를 compose가 정하므로 위 값 대신 아래를 쓴다
QA_DB_PASSWORD=
# 앱(API·동기화) 계정 songhak_app. 데이터 읽기·쓰기만 (app/app_user.py). 관리 계정 비밀번호는 migrate 컨테이너에만 들어간다
APP_DB_PASSWORD=
# S3 백업 위치 (선택, 예: s3://버킷/db). 비우면 서버에만 둔다
BACKUP_S3_URI=
# 예: 3-38-1-2.sslip.io (탄력적 IP의 점을 -로)
DOMAIN=
# Let's Encrypt 계정 이메일 (선택. 2025년부터 만료 알림 메일은 없음)
CERTBOT_EMAIL=
# 공개 데모 (demo.DOMAIN). 운영과 다른 값을 쓴다. 특히 DEMO_AUTH_SECRET이 같으면 데모 쿠키로 운영에 들어갈 수 있다
DEMO_POSTGRES_PASSWORD=
DEMO_QA_DB_PASSWORD=
DEMO_APP_DB_PASSWORD=
DEMO_AUTH_SECRET=
# 동기화 실패 알림을 받을 주소 (선택, 예: https://ntfy.sh/<추측하기 어려운 이름>)
ALERT_URL=
# 데모 하루 질문 수 (모든 방문자 합계, 기본 20)
DEMO_ASK_DAILY_LIMIT=20
