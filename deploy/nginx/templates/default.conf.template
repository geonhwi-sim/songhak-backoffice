# ${DOMAIN}은 nginx가 켜질 때 .env 값으로 바뀐다. $host 같은 nginx 변수는 그대로 남는다.

# 도메인 없이 IP로 들어오는 요청(자동 스캐너 등)은 응답 없이 끊는다
server {
    listen 80 default_server;
    return 444;
}
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;

    # Let's Encrypt 인증서 갱신 확인용
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 이 앱은 큰 파일을 받지 않는다 (질문은 300자 제한)
    client_max_body_size 1m;

    # 보안 헤더: HTTPS 강제, 다른 사이트 안에 넣어 보이기 금지, 파일 형식 추측 금지
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 자연어 질의는 재시도까지 하면 수십 초 걸릴 수 있다
        proxy_read_timeout 90s;
        # Next.js는 글꼴·스크립트 미리 불러오기(Link) 헤더가 커서 기본 버퍼(4k)를 넘으면 502가 난다
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }
}
