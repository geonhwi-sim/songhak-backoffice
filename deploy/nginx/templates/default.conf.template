# ${DOMAIN}은 nginx가 켜질 때 .env 값으로 바뀐다. $host 같은 nginx 변수는 그대로 남는다.

# 데모는 공개라 한 IP가 API를 너무 자주 부르지 못하게 한다 (초당 5회, 순간 20회까지)
limit_req_zone $binary_remote_addr zone=demo_api:10m rate=5r/s;
# 로그인 시도는 IP당 분당 10회(순간 5회 더)까지. 계정별 잠금(5회 실패 10분)과 함께 비밀번호 대입을 막는다
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_status 429;

# 도메인 없이 IP로 들어오는 요청(자동 스캐너 등)은 응답 없이 끊는다
server {
    listen 80 default_server;
    return 444;
}
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name ${DOMAIN} demo.${DOMAIN};
    server_tokens off;

    # Let's Encrypt 인증서 갱신 확인용
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 이 앱은 큰 파일을 받지 않는다 (질문은 300자 제한)
    client_max_body_size 1m;

    # 보안 헤더: HTTPS 강제, 다른 사이트 안에 넣어 보이기 금지, 파일 형식 추측 금지
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # 이 사이트의 파일만 불러온다 (외부 스크립트·이미지·전송 차단). Next.js가 넣는 인라인 스크립트·스타일은 허용
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    location ~ ^/api/auth/(login|demo)$ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }

    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 자연어 질의는 재시도까지 하면 수십 초 걸릴 수 있다
        proxy_read_timeout 90s;
        # Next.js는 글꼴·스크립트 미리 불러오기(Link) 헤더가 커서 기본 버퍼(4k)를 넘으면 502가 난다
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }
}

# 공개 데모 (같은 인증서에 demo. 이름도 들어 있다)
